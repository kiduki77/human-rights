{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-rights.local/schemas/requirements.schema.json",
  "title": "requirements",
  "type": "object",
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "goal": {
      "type": "string"
    },
    "users": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "properties": {
        "in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-\\d+"
          },
          "text": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "must",
              "should",
              "could"
            ]
          },
          "source": {
            "enum": [
              "user",
              "code",
              "inferred",
              "default"
            ]
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "additionalProperties": true,
              "required": [
                "id",
                "text"
              ]
            }
          }
        },
        "additionalProperties": true,
        "required": [
          "id",
          "text"
        ]
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DEC-\\d+"
          },
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "decided_by": {
            "enum": [
              "user",
              "default",
              "code"
            ]
          },
          "safety": {
            "type": "boolean"
          }
        },
        "additionalProperties": true,
        "required": [
          "id",
          "answer",
          "decided_by"
        ]
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q-\\d+"
          },
          "text": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          },
          "safety": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "open",
              "answered",
              "dropped"
            ]
          },
          "proposed_default": {
            "type": "string"
          }
        },
        "additionalProperties": true,
        "required": [
          "id",
          "text"
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "additionalProperties": true,
        "required": [
          "id",
          "text"
        ]
      }
    }
  },
  "additionalProperties": true,
  "required": [
    "revision",
    "requirements"
  ]
}

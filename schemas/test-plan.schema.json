{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-rights.local/schemas/test-plan.schema.json",
  "title": "test-plan",
  "type": "object",
  "properties": {
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TEST-\\d+"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "enum": [
              "unit",
              "component",
              "contract",
              "integration",
              "e2e",
              "regression",
              "security",
              "safety",
              "performance",
              "manual",
              "static"
            ]
          },
          "level": {
            "enum": [
              "task",
              "integration"
            ]
          },
          "task_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "command": {
            "type": [
              "string",
              "null"
            ]
          },
          "procedure": {
            "type": [
              "string",
              "null"
            ]
          },
          "environment": {
            "type": "string"
          },
          "pass_criteria": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "automation": {
            "enum": [
              "automated",
              "manual",
              "agent"
            ]
          },
          "parallel_safe": {
            "type": "boolean",
            "description": "opt-in: may run concurrently with other parallel-safe tests"
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "tests sharing a resource never run concurrently"
          },
          "exclusive": {
            "type": "boolean",
            "description": "always run alone"
          },
          "runner": {
            "enum": [
              "command",
              "agent",
              "human"
            ],
            "description": "who runs it: a script, hr-tester, or a human (needs human_reason)"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "do": {
                  "type": "string"
                },
                "expect": {
                  "type": "string"
                }
              },
              "required": [
                "do",
                "expect"
              ]
            },
            "description": "agent and human tests: each step and the observable result that counts as a pass"
          },
          "human_reason": {
            "type": "string"
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "paths whose change can alter this test's result; a passing result is kept while later commits do not touch them"
          },
          "estimated_seconds": {
            "type": "number"
          },
          "children": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Group checks only: keys of the features this check exercises together."
          }
        },
        "additionalProperties": true,
        "required": [
          "id",
          "type",
          "level",
          "pass_criteria"
        ]
      }
    },
    "regression": {
      "type": "object",
      "properties": {
        "scope": {
          "enum": [
            "targeted",
            "full"
          ]
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "scope",
        "rationale"
      ]
    }
  },
  "additionalProperties": true,
  "required": [
    "tests"
  ]
}

      "id": "TEST-013",
      "title": "Mission kept while switching selection (human check)",
      "type": "safety",
      "level": "integration",
      "task_ids": [
        "TASK-002"
      ],
      "requirement_ids": [
        "REQ-006"
      ],
      "command": null,
      "procedure": "Two SITL vehicles in AUTO missions; switch selection A->B five times while screen-recording; confirm A's mode and waypoint progress never change",
      "environment": "sitl-2 + operator",
      "pass_criteria": "AC-006 met, link to the recording",
      "required": true,
      "estimated_seconds": 900,
      "runner": "human",
      "human_reason": "judging that a real operator never loses a mission needs an operator at the SITL rig",
      "steps": [
        {
          "do": "Start two SITL vehicles A and B in AUTO missions and begin screen recording",
          "expect": "both vehicles show AUTO and advancing waypoints"
        },
        {
          "do": "Switch the selection A -> B -> A five times",
          "expect": "vehicle A's mode stays AUTO and its waypoint index never goes backwards or pauses"
        }
      ]
    }
